# LLM Serve Dashboard - Multi-stage Containerfile
# Stage 1: Build frontend (SvelteKit static site)
# Stage 2: Python runtime with built frontend assets

# =============================================================================
# Stage 1: Frontend Builder
# =============================================================================
FROM node:20-slim AS frontend-builder

WORKDIR /app

# Copy package files first for better layer caching
COPY frontend/package*.json ./

# Install dependencies
RUN npm install

# Copy frontend source
COPY frontend/ ./

# Build static site
RUN npm run build

# =============================================================================
# Stage 2: Python Runtime
# =============================================================================
FROM python:3.11-slim

# Labels
LABEL org.opencontainers.image.title="LLM Serve Dashboard"
LABEL org.opencontainers.image.description="Centralized control plane for LLM cluster"
LABEL org.opencontainers.image.version="0.1.0"
LABEL component="dashboard"

# Install system dependencies for asyncpg (PostgreSQL client)
RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy backend source code and Python package config
COPY backend/ ./backend/
COPY pyproject.toml ./

# Install Python dependencies
RUN pip install --no-cache-dir .

# Copy built frontend assets from builder stage
COPY --from=frontend-builder /app/build ./static/

# Volume mount points for persistent data
# /data/config - Container definitions, settings
# /data/db - TimescaleDB data
# /data/logs - Application logs
VOLUME ["/data/config", "/data/db", "/data/logs"]

# Expose HTTP port
EXPOSE 8080

# Run FastAPI with uvicorn (production mode)
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8080"]
